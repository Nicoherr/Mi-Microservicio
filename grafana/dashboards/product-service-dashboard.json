{
  "annotations": { "list": [] },
  "editable": true,
  "title": "DevOps Observability - Product Service (EP3)",
  "uid": "product-service-ep3",
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad del Microservicio (UP)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"product-service\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cobertura de Pruebas JaCoCo (Target CI)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "expr": "vector(85)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tiempo Medio Despliegue CI/CD (s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "process_uptime_seconds{application=\"product-service\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errores HTTP 5xx Registrados",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(http_server_requests_seconds_count{application=\"product-service\",status=~\"5..\"}) or vector(0)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Uso de CPU del Proceso (JVM)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "process_cpu_usage{application=\"product-service\"}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uso de Memoria JVM Heap (Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "jvm_memory_used_bytes{application=\"product-service\",area=\"heap\"}", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tasa de Peticiones HTTP por Endpoint y Estado",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "rate(http_server_requests_seconds_count{application=\"product-service\"}[1m])", "refId": "A" }]
    }
  ]
}
